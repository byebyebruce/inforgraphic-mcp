{
  "name": "infographic-mcp",
  "version": "1.0.0",
  "description": "MCP server for rendering infographics using @antv/infographic",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "infographic-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "postinstall": "npx playwright install chromium",
    "start": "node dist/index.js",
    "start:sse": "node dist/index.js --sse",
    "start:http": "node dist/index.js --http",
    "start:url": "tsx src/index.ts --http --url=http://localhost:3000/images --output=./images",
    "dev": "tsx src/index.ts",
    "dev:sse": "tsx src/index.ts --sse",
    "dev:http": "tsx src/index.ts --http",
    "test": "tsx src/test.ts"
  },
  "keywords": [
    "mcp",
    "infographic",
    "antv",
    "visualization"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "express": "^5.2.1",
    "playwright": "^1.57.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
